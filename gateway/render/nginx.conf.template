# Render production gateway: API-only reverse proxy.
# Rendered at boot from this template (see docker-entrypoint.sh), because
# nginx cannot read $PORT / upstream hostnames directly.
#
# Required env at boot: PORT (provided by Render), AUTH_UPSTREAM,
# GAME_UPSTREAM (public Render hostnames WITHOUT scheme/port, e.g.
# reflex-auth-abc123.onrender.com), FRONTEND_URL (Vercel URL, no trailing /).

worker_processes auto;

# Log to stderr/stdout so Render captures them (defaults go to files).
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    access_log    /dev/stdout combined;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;
    keepalive_timeout 65;

    # ── Upstreams (public Render hosts, TLS) ─────────────────
    upstream auth_service {
        server ${AUTH_UPSTREAM}:443;
    }

    upstream game_service {
        server ${GAME_UPSTREAM}:443;
    }

    # ── Rate Limiting Zones ──────────────────────────────────
    limit_req_zone $binary_remote_addr zone=auth_zone:10m  rate=5r/s;
    limit_req_zone $binary_remote_addr zone=api_zone:10m   rate=30r/s;

    server {
        listen ${PORT};
        server_name _;

        add_header X-Frame-Options       "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff"    always;

        # Render health check.
        location = /health {
            access_log off;
            add_header Content-Type application/json always;
            return 200 '{"status":"ok","service":"gateway"}';
        }

        # ── Auth Service (/api/auth/) ────────────────────────
        location /api/auth/ {
            limit_req zone=auth_zone burst=10 nodelay;

            # Credentialed CORS for the single Vercel frontend.
            add_header Access-Control-Allow-Origin      '${FRONTEND_URL}' always;
            add_header Access-Control-Allow-Credentials 'true' always;
            add_header Vary 'Origin' always;
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin      '${FRONTEND_URL}' always;
                add_header Access-Control-Allow-Credentials 'true' always;
                add_header Access-Control-Allow-Methods     'GET, POST, OPTIONS' always;
                add_header Access-Control-Allow-Headers     'Content-Type, Authorization' always;
                add_header Content-Length 0 always;
                add_header Content-Type 'text/plain' always;
                return 204;
            }

            proxy_pass           https://auth_service;
            proxy_ssl_server_name on;
            # SNI must carry the real public hostname (proxy_pass only sees
            # the upstream block name "auth_service", which the edge rejects).
            proxy_ssl_name       ${AUTH_UPSTREAM};
            # Generous timeouts: free-tier upstreams can cold-start ~60s.
            proxy_connect_timeout 75s;
            proxy_send_timeout    75s;
            proxy_read_timeout    75s;
            proxy_set_header     Host              ${AUTH_UPSTREAM};
            proxy_set_header     X-Real-IP         $remote_addr;
            proxy_set_header     X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header     X-Forwarded-Proto https;
            proxy_set_header     Cookie            $http_cookie;
            proxy_pass_header    Set-Cookie;
        }

        # ── Game Service (/api/v1/) ──────────────────────────
        location /api/v1/ {
            limit_req zone=api_zone burst=20 nodelay;

            add_header Access-Control-Allow-Origin      '${FRONTEND_URL}' always;
            add_header Access-Control-Allow-Credentials 'true' always;
            add_header Vary 'Origin' always;
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin      '${FRONTEND_URL}' always;
                add_header Access-Control-Allow-Credentials 'true' always;
                add_header Access-Control-Allow-Methods     'GET, POST, OPTIONS' always;
                add_header Access-Control-Allow-Headers     'Content-Type, Authorization' always;
                add_header Content-Length 0 always;
                add_header Content-Type 'text/plain' always;
                return 204;
            }

            proxy_pass           https://game_service;
            proxy_ssl_server_name on;
            # SNI must carry the real public hostname (see auth location).
            proxy_ssl_name       ${GAME_UPSTREAM};
            # Generous timeouts: free-tier upstreams can cold-start ~60s.
            proxy_connect_timeout 75s;
            proxy_send_timeout    75s;
            proxy_read_timeout    75s;
            proxy_set_header     Host              ${GAME_UPSTREAM};
            proxy_set_header     X-Real-IP         $remote_addr;
            proxy_set_header     X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header     X-Forwarded-Proto https;
            proxy_set_header     Cookie            $http_cookie;
            proxy_pass_header    Set-Cookie;
        }

        # ── Anything else → frontend (gateway is API-only here) ──
        location / {
            return 301 ${FRONTEND_URL}$request_uri;
        }
    }
}
