# ──────────────────────────────────────────────────────────
#  REFLEX web (.env) — the browser reads BACKEND_API_URL at BUILD time
#  (exposed via envPrefix in vite.config.ts).
#  Leave unset for local Docker (same-origin via the gateway).
#  On Vercel, set BACKEND_API_URL to your public backend, e.g.:
#      BACKEND_API_URL=https://api.example.com
#  then redeploy (build-time value — changing it needs a rebuild).
# ──────────────────────────────────────────────────────────
# BACKEND_API_URL=
